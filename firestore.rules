rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isValidProfile() {
      let interests = request.resource.data.interests;
      return request.resource.data.keys().hasOnly(['interests', 'updatedAt'])
        && request.resource.data.keys().hasAll(['interests', 'updatedAt'])
        && interests is list
        && interests.size() <= 3
        && request.resource.data.updatedAt == request.time
        && (interests.size() < 1 || interests[0] in ['building', 'planning', 'community'])
        && (interests.size() < 2 || interests[1] in ['building', 'planning', 'community'])
        && (interests.size() < 3 || interests[2] in ['building', 'planning', 'community']);
    }

    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidProfile();
    }
  }
}
